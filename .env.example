# Copy to .env locally. Set secrets in your hosting provider for deployment.
PORT=4000
ALLOWED_ORIGINS=https://comfortzoneproducts.com,https://www.comfortzoneproducts.com

# Sunshine Conversations API (outbound) and webhook (inbound) are separate secrets.
SUNSHINE_APP_ID=
SUNSHINE_KEY_ID=
SUNSHINE_KEY_SECRET=
SUNSHINE_WEBHOOK_SECRET=
SUNSHINE_INTEGRATION_ID=
SUNSHINE_AGENT_WORKSPACE_INTEGRATION_ID=

# Map each Zendesk conversation brandId to exactly one knowledge partition.
WIDGET_ID_MR_BRAND=
WIDGET_ID_COMFORT_ZONE=
SUPPORT_NAME_MR_BRAND=Mr Brand
SUPPORT_NAME_COMFORT_ZONE=Comfort Zone

# Your website's authenticated session JWT, signed with RS256.
WEBSITE_SESSION_JWKS_URL=https://your-site.example/.well-known/jwks.json
WEBSITE_SESSION_ISSUER=https://your-site.example/
WEBSITE_SESSION_AUDIENCE=zendesk-widget
# Zendesk Admin Center > End user authentication: different key from website JWT.
ZENDESK_WIDGET_KEY_ID=
ZENDESK_WIDGET_JWT_SECRET=
REPORT_API_KEY=

# Microsoft SQL Server (SQL authentication). The configured database/schema
# must already exist; explicit migrations create the three app tables; startup only verifies.
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=dbo
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_PLANNER_MODEL=claude-haiku-4-5-20251001
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_ID=zendesk-rag
COSMOS_CONTAINER_ID=knowledge
RAG_VECTOR_DIMENSIONS=1024
COSMOS_VECTOR_INDEX_TYPE=quantizedFlat
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_BUSINESS_HOURS_SCHEDULE_ID=
ZENDESK_SCHEDULE_DYNAMIC_CONTENT_ID=
CATEGORY_OBJECT_NAME=

# Monitoring uses a fixed two-hour customer inactivity gap and five-hour ticket lookback.
BOT_RESPONSE_TARGET_MS=15000
BOT_RESPONSE_HARD_TIMEOUT_MS=45000
BOT_DELIVERY_RESERVE_MS=4000
BOT_SEND_TIMEOUT_MS=3000
BOT_TYPING_STOP_TIMEOUT_MS=1500
BOT_STATE_SAVE_TIMEOUT_MS=1500
RAG_QUERY_PLANNING_ENABLED=true
RAG_CITATION_REPAIR_ENABLED=true

# Prompt context limits
BOT_HISTORY_MESSAGES=10
RAG_FINAL_CHUNK_COUNT=5
RAG_MAX_STRUCTURED_RESULTS=20
