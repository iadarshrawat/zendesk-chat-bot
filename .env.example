# Copy to .env locally. Set secrets in your hosting provider for deployment.
NODE_ENV=production
PORT=4000
ALLOWED_ORIGINS=https://comfortzoneproducts.com,https://www.comfortzoneproducts.com

# Sunshine Conversations API (outbound) and webhook (inbound) are separate secrets.
SUNSHINE_APP_ID=
SUNSHINE_KEY_ID=
SUNSHINE_KEY_SECRET=
SUNSHINE_WEBHOOK_SECRET=
SUNSHINE_INTEGRATION_ID=
SUNSHINE_AGENT_WORKSPACE_INTEGRATION_ID=

# Map each Zendesk conversation brandId to exactly one knowledge partition.
WIDGET_ID_MR_BRAND=
WIDGET_ID_COMFORT_ZONE=
SUPPORT_NAME_MR_BRAND=Mr Brand
SUPPORT_NAME_COMFORT_ZONE=Comfort Zone
# Optional white-label routing replaces the legacy mapping above. Keys must match ingested knowledge partitions.
# SUPPORT_BRANDS_JSON='[{"key":"example-support","displayName":"Example Support","widgetIds":["your-zendesk-brand-id"],"aliases":[],"instructions":"Describe your business scope and workflow here."}]'
# Optional shared context; per-brand instructions take precedence when provided.
BOT_CONTEXT=
# live keeps the current handoff. follow_up routes the request for later human contact.
BOT_SUPPORT_MODE=live
# Elapsed hours from confirmed escalation, including weekends; no callback scheduler is created.
BOT_FOLLOW_UP_HOURS=24
# Per-brand SUPPORT_BRANDS_JSON overrides: "supportMode":"follow_up","followUpHours":24

# Your website's authenticated session JWT, signed with RS256.
WEBSITE_SESSION_JWKS_URL=https://your-site.example/.well-known/jwks.json
WEBSITE_SESSION_ISSUER=https://your-site.example/
WEBSITE_SESSION_AUDIENCE=zendesk-widget
# Zendesk Admin Center > End user authentication: different key from website JWT.
ZENDESK_WIDGET_KEY_ID=
ZENDESK_WIDGET_JWT_SECRET=
# Backend report secret. Set the same value in the navbar's secure installation setting.
# Rotate any value previously included in frontend source or app ZIPs.
REPORT_API_KEY=

# Microsoft SQL Server (SQL authentication). The configured database/schema
# must already exist; explicit migrations create the six app tables; startup only verifies.
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=dbo
# Empty uses production table names. Set test_ for separate testing tables in the same database/schema.
DB_TABLE_PREFIX=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_PLANNER_MODEL=claude-haiku-4-5-20251001
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_ID=zendesk-rag
COSMOS_CONTAINER_ID=knowledge
RAG_VECTOR_DIMENSIONS=1024
COSMOS_VECTOR_INDEX_TYPE=quantizedFlat
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Required when at least one configured brand uses live support.
ZENDESK_BUSINESS_HOURS_SCHEDULE_ID=
ZENDESK_SCHEDULE_DYNAMIC_CONTENT_ID=
CATEGORY_OBJECT_NAME=

# Monitoring: ticket updated_at lookback and gap between customer messages, in hours.
# Fractions are allowed: 0.5 = 30 minutes. Lookback must exceed the session gap.
MONITOR_LOOKBACK_HOURS=5
MONITOR_SESSION_IDLE_HOURS=2
# Time between monitoring polls, in minutes. Fractions are allowed: 0.5 = 30 seconds.
MONITOR_POLL_INTERVAL_MINUTES=5

# Bot response time limits
BOT_RESPONSE_TARGET_MS=15000
BOT_RESPONSE_HARD_TIMEOUT_MS=45000
BOT_DELIVERY_RESERVE_MS=4000
BOT_SEND_TIMEOUT_MS=3000
BOT_TYPING_STOP_TIMEOUT_MS=1500
BOT_STATE_SAVE_TIMEOUT_MS=1500
# Concurrent conversations within one process; each conversation remains ordered. Range: 1–8.
BOT_INBOX_CONCURRENCY=2
RAG_QUERY_PLANNING_ENABLED=true
RAG_CITATION_REPAIR_ENABLED=true
# Completed catalog/vector read cache, isolated by brand and published revision. 0 disables it.
RAG_READ_CACHE_MS=30000

# Prompt context limits
BOT_HISTORY_MESSAGES=10
RAG_FINAL_CHUNK_COUNT=5
RAG_MAX_STRUCTURED_RESULTS=20
