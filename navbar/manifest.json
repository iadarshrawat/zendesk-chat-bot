{
  "name": "AI Ticket Monitoring",
  "author": {
    "name": "Support Platform Team",
    "email": "admin@example.com",
    "url": "https://example.com"
  },
  "defaultLocale": "en",
  "private": true,
  "singleInstall": true,
  "location": {
    "support": {
      "nav_bar": "assets/index.html"
    }
  },
  "version": "1.5.0",
  "frameworkVersion": "2.0",
  "domainWhitelist": ["{{setting.monitoring_api_hostname}}"],
  "parameters": [
    {
      "name": "monitoring_api_hostname",
      "type": "text",
      "required": true
    },
    {
      "name": "monitoring_api_key",
      "type": "text",
      "required": true,
      "secure": true,
      "scopes": ["header"]
    }
  ]
}
